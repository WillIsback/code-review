VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_MODEL=
VLLM_API_KEY=none
VLLM_TIMEOUT_SECS=120
VLLM_RETRIES=2
# Optional: max characters of source context sent for verification
REVIEW_MAX_CONTEXT=100000
# Optional: extra HTTP headers sent with every vLLM request, one "Name: Value" per line.
# This file supports a single line; for multiple headers use the action's `extra-headers` input.
# EXTRA_HEADERS=X-Api-Key: changeme
# Optional: target selection for local runs
TARGET_TYPE=pr
TARGET_NUMBER=
HEAD_SHA=

# Required for local runs
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=
