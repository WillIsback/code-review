VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_MODEL=
VLLM_API_KEY=none
VLLM_TIMEOUT_SECS=120
VLLM_RETRIES=2
# Optional: max characters of source context sent for verification
REVIEW_MAX_CONTEXT=100000
# Optional: Cloudflare Access service token (when vLLM is behind Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional: target selection for local runs
TARGET_TYPE=pr
TARGET_NUMBER=
HEAD_SHA=

# Required for local runs
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=
